apiVersion: v1
kind: Service
metadata:
  name: legeni-webapp
  namespace: "{{ k8s_namespace }}"
spec:
  type: NodePort
  selector:
    app: legeni-webapp
  ports:
    - port: 80
      targetPort: 5000
      nodePort: {{ node_port }}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: legeni-webapp-ingress
  namespace: "{{ k8s_namespace }}"
spec:
  ingressClassName: nginx
  rules:
    - host: "{{ ingress_host }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: legeni-webapp
                port:
                  number: 80
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: legeni-webapp-hpa
  namespace: "{{ k8s_namespace }}"
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: legeni-webapp
  minReplicas: {{ app_replicas }}
  maxReplicas: 5
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
